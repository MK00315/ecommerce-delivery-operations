	partition 'Daily Reviews' = m
		mode: import
		source =
				let
				    Snapshot=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.Deflate)),
				    Rows=Table.FromRows(Snapshot,{"Scenario Key", "Policy Key", "Screening Date", "Candidates", "Candidate Known Late", "Selected", "Used Minutes", "Unknown Selected", "Known Late Selected", "Priority Points", "Selected Known Outcomes", "Unused Minutes"}),
				    Typed=Table.TransformColumnTypes(Rows,{{"Scenario Key", type text}, {"Policy Key", type text}, {"Screening Date", type date}, {"Candidates", Int64.Type}, {"Candidate Known Late", Int64.Type}, {"Selected", Int64.Type}, {"Used Minutes", Int64.Type}, {"Unknown Selected", Int64.Type}, {"Known Late Selected", Int64.Type}, {"Priority Points", type number}, {"Selected Known Outcomes", Int64.Type}, {"Unused Minutes", Int64.Type}},"en-US")
