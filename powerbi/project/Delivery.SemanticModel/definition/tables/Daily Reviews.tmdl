table 'Daily Reviews'
	lineageTag: a9fd301e-ac39-4708-b9c9-2c9b7fb59281

	measure 'Review Count' = VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Selected]),'Scenarios'[Scenario Key]=s)
		formatString: #,##0
		lineageTag: e3ff50ce-ecd1-45f9-be90-133773aa3fbb

	measure 'Review Minutes' = VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Used Minutes]),'Scenarios'[Scenario Key]=s)
		formatString: #,##0
		lineageTag: fae9aa4b-3c97-4be0-ba2e-e9d56a76259c

	measure 'Unknown Reviews' = VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Unknown Selected]),'Scenarios'[Scenario Key]=s)
		formatString: #,##0
		lineageTag: cf8a6c21-1f9d-4050-8672-9c892cdb9b99

	measure 'Known Late Reviewed' = VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Known Late Selected]),'Scenarios'[Scenario Key]=s)
		formatString: #,##0
		lineageTag: f49c35df-dac1-4c04-8e39-456f48f28295

	measure 'Review Priority Points' = VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Priority Points]),'Scenarios'[Scenario Key]=s)
		formatString: #,##0.0
		lineageTag: 772a73a2-c518-49bf-986f-2fbf9403e740

	measure 'Queue Known Late' = VAR s=[Selected Scenario] RETURN CALCULATE(SUMX(VALUES('Daily Reviews'[Screening Date]),CALCULATE(MAX('Daily Reviews'[Candidate Known Late]))),'Scenarios'[Scenario Key]=s)
		formatString: #,##0
		lineageTag: 9558adb6-b869-4b3e-9e75-0caa501d7af7

	measure 'Known Late Capture' = DIVIDE([Known Late Reviewed],[Queue Known Late])
		formatString: 0.0%
		lineageTag: 0510bd76-18c0-44ec-9fc0-eaba5b64c53f

	measure 'Optimized Reviews' = CALCULATE([Review Count],'Policies'[Policy Key]="optimized")
		formatString: #,##0
		lineageTag: 28122d70-1490-4b33-9539-04a5ff524f95

	measure 'Optimized Known Late' = CALCULATE([Known Late Reviewed],'Policies'[Policy Key]="optimized")
		formatString: #,##0
		lineageTag: b5e7778b-0847-478c-b6bd-03af1d5c44c2

	measure 'Optimized Unknown' = CALCULATE([Unknown Reviews],'Policies'[Policy Key]="optimized")
		formatString: #,##0
		lineageTag: 9c6df1e9-1ad8-4ca5-82d7-1ae8e248d025

	measure 'Optimized Minutes' = CALCULATE([Review Minutes],'Policies'[Policy Key]="optimized")
		formatString: #,##0
		lineageTag: e9eb3661-cbff-4ced-8042-7396ffae297c

