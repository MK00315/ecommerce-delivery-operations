table Orders
	lineageTag: 8cff1391-894e-4634-bb9a-27bd25e72f64

	measure 'Source Orders' = COUNTROWS('Orders')
		formatString: #,##0
		lineageTag: 414f2a96-4a3a-43e2-876a-3b65f4fa233f

	measure 'Eligible Deliveries' = SUM('Orders'[SLA Eligible])
		formatString: #,##0
		lineageTag: b3b07603-514e-418e-aa1c-d51a971ae67f

	measure 'Late Deliveries' = SUM('Orders'[Late Flag])
		formatString: #,##0
		lineageTag: 9f58cf37-bea3-460f-9fee-04f08c19e78a

	measure 'On-time Deliveries' = [Eligible Deliveries]-[Late Deliveries]
		formatString: #,##0
		lineageTag: cb8f6fbc-5907-4be8-ac28-7665b9dedfb2

	measure 'Late Rate' = DIVIDE([Late Deliveries],[Eligible Deliveries])
		formatString: 0.00%
		lineageTag: 773d0f4d-bd73-4f0f-9439-ef031e992ffc

	measure 'Outside SLA Cohort' = [Source Orders]-[Eligible Deliveries]
		formatString: #,##0
		lineageTag: abb61698-daf5-4b9e-a85a-8a9c322527a1

	measure 'Mean Delivery Days' = AVERAGE('Orders'[Delivery Days])
		formatString: 0.00
		lineageTag: 725d8810-f6ab-4438-8d26-7488107b51bf

	measure 'Median Delivery Days' = MEDIAN('Orders'[Delivery Days])
		formatString: 0.00
		lineageTag: b3ced0f9-681c-4842-8fc3-4c6e4982b96a

	measure 'Complete Distance Share' = DIVIDE(CALCULATE([Eligible Deliveries],'Orders'[Distance Complete]=1),[Eligible Deliveries])
		formatString: 0.0%
		lineageTag: e95dc19a-394f-4205-8c04-957cdaae6366

