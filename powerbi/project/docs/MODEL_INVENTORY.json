    "measures": [
      [
        "Review Count",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Selected]),'Scenarios'[Scenario Key]=s)",
        "#,##0"
      ],
      [
        "Review Minutes",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Used Minutes]),'Scenarios'[Scenario Key]=s)",
        "#,##0"
      ],
      [
        "Unknown Reviews",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Unknown Selected]),'Scenarios'[Scenario Key]=s)",
        "#,##0"
      ],
      [
        "Known Late Reviewed",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Known Late Selected]),'Scenarios'[Scenario Key]=s)",
        "#,##0"
      ],
      [
        "Review Priority Points",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUM('Daily Reviews'[Priority Points]),'Scenarios'[Scenario Key]=s)",
        "#,##0.0"
      ],
      [
        "Queue Known Late",
        "VAR s=[Selected Scenario] RETURN CALCULATE(SUMX(VALUES('Daily Reviews'[Screening Date]),CALCULATE(MAX('Daily Reviews'[Candidate Known Late]))),'Scenarios'[Scenario Key]=s)",
        "#,##0"
      ],
      [
        "Known Late Capture",
        "DIVIDE([Known Late Reviewed],[Queue Known Late])",
        "0.0%"
      ],
      [
        "Optimized Reviews",
        "CALCULATE([Review Count],'Policies'[Policy Key]=\"optimized\")",
        "#,##0"
      ],
      [
        "Optimized Known Late",
        "CALCULATE([Known Late Reviewed],'Policies'[Policy Key]=\"optimized\")",
        "#,##0"
      ],
      [
        "Optimized Unknown",
        "CALCULATE([Unknown Reviews],'Policies'[Policy Key]=\"optimized\")",
        "#,##0"
      ],
      [
        "Optimized Minutes",
        "CALCULATE([Review Minutes],'Policies'[Policy Key]=\"optimized\")",
        "#,##0"
      ]
    ]
