    "measures": [
      [
        "Source Orders",
        "COUNTROWS('Orders')",
        "#,##0"
      ],
      [
        "Eligible Deliveries",
        "SUM('Orders'[SLA Eligible])",
        "#,##0"
      ],
      [
        "Late Deliveries",
        "SUM('Orders'[Late Flag])",
        "#,##0"
      ],
      [
        "On-time Deliveries",
        "[Eligible Deliveries]-[Late Deliveries]",
        "#,##0"
      ],
      [
        "Late Rate",
        "DIVIDE([Late Deliveries],[Eligible Deliveries])",
        "0.00%"
      ],
      [
        "Outside SLA Cohort",
        "[Source Orders]-[Eligible Deliveries]",
        "#,##0"
      ],
      [
        "Mean Delivery Days",
        "AVERAGE('Orders'[Delivery Days])",
        "0.00"
      ],
      [
        "Median Delivery Days",
        "MEDIAN('Orders'[Delivery Days])",
        "0.00"
      ],
      [
        "Complete Distance Share",
        "DIVIDE(CALCULATE([Eligible Deliveries],'Orders'[Distance Complete]=1),[Eligible Deliveries])",
        "0.0%"
      ]
    ]
  },
