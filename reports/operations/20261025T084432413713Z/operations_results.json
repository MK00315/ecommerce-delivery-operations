        "multiple_items_extra": 2,
        "multiple_sellers_extra": 3,
        "interstate_or_unknown_extra": 1
      },
      "cost_assumption": "Illustrative review durations, not measured Olist staffing data; integer ceiling after sensitivity multiplier",
      "priority": "100 * (n - within-batch rank + 1) / n; raw model score descending, order ID breaks ties; no whole-August percentile used",
      "objective": "Maximize sum of ordinal review-priority points under time, count and primary-seller limits; points are not calibrated expected late orders",
      "baselines": [
        "risk_first",
        "priority_per_minute",
        "oldest_first"
