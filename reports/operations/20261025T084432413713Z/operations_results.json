          "definition": "Purchase-to-promised calendar days"
        },
        {
          "id": "interstate",
          "label": "Any interstate seller vs all same-state",
          "definition": "All item seller/customer states must be known"
        }
      ],
      "method": "Separate linear probability contrasts with purchase-month fixed effects and CR1 purchase-week clustered standard errors; two-sided Student t with G-1 df",
      "multiplicity": "Holm correction over exactly four primary week-clustered p-values, alpha 0.05",
      "sensitivity": "Purchase-day clustered intervals; descriptive group rates and explicit exclusions",
      "limits": "Thresholds fixed for this analysis after prior exploration, not preregistered. Monthly adjustment is not full confounder control. Week clusters assume independence across weeks; repeat sellers/customers and longer serial dependence remain. Conditional on completed observed deliveries."
    },
    "planner": {
      "input": "Saved August approval-time scores; August has already been inspected and is a reused diagnostic",
      "batch": "All previous calendar day's approvals; screen at 09:00 the next day, source timestamps as recorded",
      "known_completion_rule": "Exclude only deliveries with a recorded delivered_at strictly before the screening cutoff; never inspect future status or late labels to select",
      "carryover": "None. Each approval is offered once; unselected orders leave this simulation",
      "capacity_minutes_per_batch": 120,
      "maximum_reviews_per_batch": 30,
      "maximum_reviews_per_primary_seller": 5,
      "capacity_pool": "Pooled team minutes, not an individual reviewer shift schedule",
      "review_minutes": {
